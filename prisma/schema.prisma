// Postaí — SaaS de postagem automática no Instagram (carrossel + feed por IA).
// Multi-marca: cada Marca tem sua identidade visual e sua conexão própria com a Meta.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// Uma marca/cliente que posta pelo Postaí (ex: Castelo da Diversão).
model Marca {
  id          String   @id @default(cuid())
  slug        String   @unique
  nome        String
  // Identidade visual — cada marca com a sua cara nas artes
  corPrimaria String   @default("#7C3AED") // cor de destaque (faixa, traço, CTA)
  corFundo    String   @default("#0E0E0E") // fundo das artes de cor sólida
  paleta      String   @default("[]") // cores vivas do logo (JSON array de hex) — régua/detalhes multicolor nas artes
  logoTexto   String   @default("") // texto da faixa da marca (ex: "CASTELO DA DIVERSÃO")
  musicas     String   @default("[]") // biblioteca de trilhas do vídeo enviadas pelo dono: JSON [{url,nome}]
  capasArte   String   @default("[]") // biblioteca de ARTES de capa geradas pela IA (pra reusar): JSON [url,...]
  feedArtes   String   @default("[]") // biblioteca de ARTES de fundo de feed geradas pela IA (pra reusar): JSON [url,...]
  mascoteUrl  String   @default("") // MASCOTE oficial da marca (PNG transparente) — colado nos posts/vídeos pra ficar sempre igual
  mascotesArte String  @default("[]") // biblioteca de opções de mascote geradas pela IA (pra escolher/trocar): JSON [url,...]
  logoUrl     String   @default("") // logotipo (PNG) — aparece na faixa da arte e a IA lê as cores dele
  site        String   @default("") // aparece no rodapé das artes
  telefone    String   @default("") // aparece no rodapé/CTA
  // Conexão com o Instagram (Meta Graph API) — própria de cada marca
  igUserId    String   @default("") // IG User ID da conta
  accessToken String   @default("") // token do Usuário do Sistema com permissão de postar
  fbPageId    String   @default("") // ID da Página do Facebook — se preenchido, posta também no FB
  // Agenda automática: dias da semana (0=dom … 6=sáb) de cada tipo + hora (BRT)
  diasCarrossel String @default("1,3,5") // seg/qua/sex
  diasFeed      String @default("2,4,6") // ter/qui/sáb
  horaPost      Int    @default(10) // hora do FEED (BRT) — nome mantido por compatibilidade
  horaCarrossel Int    @default(10) // hora do CARROSSEL (BRT)
  // Espelhar no Story: ligado = todo post de feed que o piloto publica também sobe
  // como Story (cada publicação pode sobrescrever isso no campo `espelhar`).
  espelharStory Boolean @default(false)
  // Contexto pra IA escrever no tom da marca
  descricao   String   @default("") // o que é o negócio, público, produtos
  ativa       Boolean  @default(true)
  // Álbum da Festa: token SECRETO do link público que o gerente do buffet usa pra subir
  // fotos das festas (sem login). Vazio = link ainda não gerado. Regerar revoga o anterior.
  tokenFotos  String   @default("")
  criadoEm    DateTime @default(now())

  // Inteligência: a análise do HISTÓRICO do Instagram ("A Bia estudou seu feed") cacheada,
  // pra o cérebro oficial da Bia (cartão da aba Redes + sugestão de próximo post) usar sem
  // repuxar o Instagram a cada carregamento do painel.
  intelHistorico   Json?     // AnaliseInsights serializada (saída de analisarEngajamento)
  intelHistoricoEm DateTime? // quando o dono mandou a Bia estudar o feed pela última vez

  // Dono (cliente) da marca — null = sem dono, só o admin vê. Multi-tenant: cada
  // cliente entra e vê SÓ as marcas dele; o admin (você) vê todas.
  usuarioId   String?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  conteudos   Conteudo[]
  publicacoes Publicacao[]
  imagens     ImagemMarca[]
  metricas    MetricaMarca[]
  festas      Festa[]
  campanhas   Campanha[]
  videosTematicos VideoTematico[]

  @@index([usuarioId])
}

// Vídeo TEMÁTICO do buffet (Reels institucional, SEM festa): montado com fotos do ACERVO
// (ImagemMarca) sobre um tema — "Brinquedos", "Nosso espaço", "Decorações de festa"...
// É evergreen: o MP4 fica guardado pra repostar quando quiser (não entra no arquivamento
// de 24h dos Reels de festa). videoUrl usa a mesma máquina de estados da Festa:
// "" (sem vídeo) | "gerando" (motor montando) | URL http (pronto).
model VideoTematico {
  id              String   @id @default(cuid())
  marcaId         String
  marca           Marca    @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  titulo          String // o tema do vídeo (vira o texto da capa)
  videoFotos      String   @default("[]") // JSON: IDs de ImagemMarca na ordem do slideshow
  // LEGENDAS por foto (a copy que aparece embaixo da imagem no vídeo). JSON: mapa
  // { fotoId: "frase" } — foto sem entrada (ou frase vazia) passa limpa, sem texto.
  // A Bia escreve uma copy com começo-meio-fim nas fotos-chave; o dono edita no seletor.
  videoTextos     String   @default("{}")
  videoCapa       String   @default("") // ID da foto da capa ("" = 1ª da sequência)
  videoMoldura    String   @default("branca") // nenhuma | branca | grossa | preta | marca
  videoMolduraCor String   @default("") // cor da moldura quando videoMoldura = "marca" (hex); "" = cor da marca
  videoTextoFinal String   @default("") // frase do último quadro ("" = padrão do motor)
  videoFundo      String   @default("") // fundo do quadro: "" (foto borrada, padrão) | "cheia" (foto preenche a tela) | "cor" (degradê de cor)
  videoFundoCor   String   @default("") // cor do fundo quando videoFundo = "cor" (hex); "" = cor da marca
  capaEstilo      String   @default("") // estilo da CAPA (1º quadro): "" (clássica) | "impacto" (foto na tela toda + texto) | "ia" (arte festiva da IA + texto)
  capaIaUrl       String   @default("") // URL (Blob) da arte de capa gerada pela IA — usada quando capaEstilo = "ia"
  capaRecorteUrl  String   @default("") // URL (Blob) da foto RECORTADA (assunto sem fundo) — usada quando capaEstilo = "recortado"
  mascoteCanto    String   @default("") // MASCOTE nos quadros do vídeo: "" (não) | dir | esq | cima-dir | cima-esq
  mascoteTam      String   @default("m") // tamanho do mascote no vídeo: p | m | g
  videoMusica     String   @default("") // trilha escolhida (URL do MP3); "" = jingle do buffet. Vale quando NÃO há narração.
  videoUrl        String   @default("")
  // Quando o MP4 FICOU PRONTO (o motor avisou). Diferente de `criadoEm`: o vídeo do buffet é
  // remontado várias vezes (troca de fotos, narração nova) e o dono precisa saber a idade do
  // ARQUIVO que está no ar. null = vídeo antigo, feito antes deste campo → cai no `criadoEm`.
  videoEm         DateTime?
  // NARRAÇÃO (a voz que fala no vídeo). O roteiro sai da Bia (a partir do briefing do dono) ou
  // é escrito na mão; a voz é do Google (Chirp3-HD, pt-BR). O áudio final é a locução MISTURADA
  // com o jingle da marca (o motor só aceita UMA trilha) e mora no Blob.
  narracaoTexto String @default("") // o roteiro falado ("" = vídeo sem narração, só o jingle)
  narracaoVoz   String @default("") // id da voz Gemini (ex: Puck, Leda, Fenrir…)
  // DIREÇÃO DE VOZ: o briefing de COMO falar ("animador de festinha, showman paulista, energia
  // de circo, abertura explosiva…"). As vozes Gemini obedecem isso de verdade — é o que tira o
  // tom robótico. "" = usa a direção padrão (animada e calorosa).
  narracaoEstilo String @default("")
  narracaoUrl   String @default("") // MP3 pronto (voz + jingle) no Blob
  narracaoSeg   Int    @default(0)  // duração da narração — define quantas fotos o vídeo leva
  criadoEm        DateTime @default(now())

  publicacoes Publicacao[] // os Reels agendados/postados a partir deste vídeo (evergreen: vários)

  @@index([marcaId])
}

// Campanha = uma OFERTA (banner de recompra) que o buffet cria e que aparece no fim de cada
// álbum pros pais (no pico do encantamento). Uma campanha vale pra marca toda: a ATIVA mais
// recente é a que aparece nos álbuns. O número do WhatsApp vem da Marca (não se repete aqui).
model Campanha {
  id        String   @id @default(cuid())
  marcaId   String
  marca     Marca    @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  selo      String   @default("") // badge de urgência (ex: "Condição especial · 15 dias")
  titulo    String                 // chamada principal (ex: "Já pensou na próxima festa?")
  texto     String   @default("") // descrição da oferta
  ctaTexto  String   @default("Quero saber mais") // texto do botão
  // Pra onde o botão leva: "whatsapp" (usa o telefone da Marca + a mensagem abaixo) ou "link".
  ctaTipo   String   @default("whatsapp")
  ctaValor  String   @default("") // whatsapp: mensagem pré-escrita · link: a URL de destino
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  @@index([marcaId])
}

// Uma festa real do buffet (aniversário). O GERENTE cria pelo link público (Álbum da Festa),
// informando data + aniversariante + tema, e vai subindo as fotos conforme a festa acontece.
// As fotos viram ImagemMarca (categoria "festa") amarradas a esta Festa — assim cada festa
// abastece o banco de imagens (entra no rodízio das artes) E fica organizada por evento.
model Festa {
  id             String   @id @default(cuid())
  marcaId        String
  marca          Marca    @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  // Token do link PRÓPRIO e ISOLADO desta festa: quem tem ele só acessa ESTA festa (não as
  // outras). Gerado na criação; backfill preenche as antigas. Vazio nunca casa (lib/festa.ts).
  token          String   @default("")
  // Token do link PÚBLICO e SÓ-LEITURA do Álbum pros pais (compartilhável). É SEPARADO de `token`
  // (que dá acesso de EDIÇÃO ao gerente) — quem tem só o álbum nunca consegue editar a festa.
  // Gerado na criação; backfill preenche as antigas. Vazio nunca casa (lib/festa.ts).
  tokenAlbum     String   @default("")
  data           DateTime // dia da festa
  // Label de exibição (nomes juntados, ex: "Maria e João") — derivado de `aniversariantes`,
  // mantido pra exibição/busca rápida. A fonte da verdade é o JSON abaixo.
  aniversariante String
  // Lista estruturada (JSON): [{ "nome": "Maria", "idade": 5 }] — uma festa pode ter mais de
  // um aniversariante (gêmeos, irmãos), e cada um tem sua idade (opcional). Ver lib/aniversariantes.ts.
  aniversariantes String  @default("[]")
  tema           String   @default("") // tema da festa (ex: "Frozen", "Super-heróis")
  // @ do Instagram do ANFITRIÃO (família da festa). O gerente anota; ao postar o Reels da festa,
  // o @ entra na legenda pra MARCAR a família (notifica + alcança os seguidores dela). "" = sem.
  instagramAnfitriao String @default("")
  // Nome de quem REGISTROU as fotos (o gerente preenche no link da festa) — pra o dono saber
  // quem documentou cada evento. "" = não informado.
  gerente        String   @default("")
  // Horário da festa (HH:MM) — pra distinguir festas no mesmo dia. "" = não informado.
  horario        String   @default("")
  // Quando o gerente marca "finalizei o envio". null = ainda subindo fotos. Sinaliza ao dono
  // que a festa está COMPLETA (pronta pra usar/gerar post). Pode reabrir pra adicionar mais.
  finalizadaEm   DateTime?
  // Autorização de uso de imagem (direito de imagem / LGPD): o gerente registra se os PAIS
  // autorizaram a divulgação pública das fotos. "pendente" | "autorizada" | "negada".
  // SÓ "autorizada" libera divulgar (álbum pros pais + posts no Instagram + funções futuras);
  // pendente/negada = fotos ficam guardadas pra uso interno, nunca viram divulgação pública.
  autorizacao    String   @default("pendente")
  motivoNaoAutoriza String @default("") // motivo quando os pais NÃO autorizam (o gerente escreve)
  // Seleção de fotos pro VÍDEO/Reels da festa: JSON ["fotoId1","fotoId2",...] na ORDEM escolhida.
  // "[]" = sem seleção (cai nas fotos automáticas). O dono monta na tela "escolher fotos do vídeo".
  videoFotos     String   @default("[]")
  // Foto escolhida pra CAPA do vídeo (fotoId). "" = sem escolha → o motor usa a 1ª foto.
  // A capa entra NÍTIDA com o título por cima (gradiente pra legibilidade), não mais fundo preto.
  videoCapa      String   @default("")
  // Moldura das fotos no vídeo: "nenhuma" | "branca" | "grossa" (polaroid) | "marca" (cor da marca).
  videoMoldura   String   @default("branca")
  // Mensagem do SLIDE FINAL do vídeo (o dono escreve ou a Bia gera). "" = usa o padrão do motor.
  videoTextoFinal String  @default("")
  // Título da CAPA do vídeo, escrito à mão pelo dono. "" = usa o automático ("Fulano fez X aninhos",
  // ver lib/aniversariantes.ts tituloCapaFesta). A rota /api/capa-festa desenha (quebra linha).
  videoTituloCapa String  @default("")
  // Trilha sonora do vídeo desta festa (URL do MP3 no Blob, enviado pelo dono). "" = usa a música
  // padrão do buffet (lib/musica-buffet.ts). Assim cada festa pode ter uma música própria.
  videoMusica    String   @default("")
  // URL do VÍDEO/Reels já montado desta festa (no Blob). "" = ainda não gerado.
  videoUrl       String   @default("")
  // O gerente liga/desliga o card "Avalie no Google" no álbum dos pais (por festa).
  mostrarAvaliacao Boolean @default(true)
  criadoEm       DateTime @default(now())

  fotos          ImagemMarca[]

  @@index([marcaId, data])
}

// Banco de fotos REAIS do negócio (ex: espaço, brinquedos, festas do buffet).
// Usadas nas artes no lugar de imagens de IA — pra nunca mostrar espaço "fake".
model ImagemMarca {
  id        String   @id @default(cuid())
  marcaId   String
  marca     Marca    @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  url       String
  categoria String   @default("geral") // espaco | brinquedos | festa | comida | geral
  // Descrição curta gerada pela IA (visão) UMA vez no upload (ex: "Mesa de doces colorida").
  // Serve pra casar a foto certa com o texto do post — sem pagar "visão" a cada geração.
  descricao String   @default("")
  usos      Int      @default(0) // contador pra rodízio: sorteia sempre a menos usada
  // Festa de origem (Álbum da Festa). null = foto solta do banco (subida no painel).
  // SetNull: apagar a festa não apaga as fotos (elas seguem no banco da marca).
  festaId   String?
  festa     Festa?   @relation(fields: [festaId], references: [id], onDelete: SetNull)
  // Momento guiado do Álbum da Festa (salao|brinquedos|aniversariante|parabens|momentos).
  // "" = foto que não veio pelo álbum. Ver lib/momentos-festa.ts.
  momento   String   @default("")
  criadoEm  DateTime @default(now())

  @@index([marcaId, categoria])
  @@index([festaId])
}

// Carrossel (2 a 10 artes) agendado pra uma marca.
model Conteudo {
  id          String   @id @default(cuid())
  marcaId     String
  marca       Marca    @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  slug        String   @unique
  data        DateTime
  titulo      String
  legenda     String
  hashtags    String
  slides      String // JSON: URLs das artes dos slides
  slidesTexto String? // JSON: texto de cada slide
  tema        String?
  // Categoria de INTENÇÃO de marketing (espaco|prova_social|oferta|institucional|sazonal|conteudo).
  // É o eixo da inteligência do Postaí: cruza categoria × engajamento pra descobrir que TIPO
  // de post mais vende festa. null = ainda não classificado (o backfill preenche).
  categoria   String?
  status      String   @default("a_postar") // a_postar | postado
  aprovado    Boolean  @default(false) // revisão INTERNA do dono (não vai pra rede) — só marca "eu já revisei"
  postadoEm   DateTime? // momento REAL em que foi publicado (null = ainda não postado)
  // Engajamento no Instagram (coletado pelo piloto após postar). null = ainda não medido.
  mediaId     String? // ID da mídia no Instagram (chave pra buscar os insights)
  curtidas    Int? // ❤️ curtidas
  comentarios Int? // 💬 comentários
  alcance     Int? // 👁️ pessoas alcançadas (reach)
  salvamentos Int? // 🔖 salvamentos
  insightsEm  DateTime? // quando os números foram atualizados pela última vez
  createdAt   DateTime @default(now())

  @@index([marcaId, data])
}

// Post de feed (imagem única) agendado pra uma marca.
model Publicacao {
  id        String   @id @default(cuid())
  marcaId   String
  marca     Marca    @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  slug      String   @unique
  data      DateTime
  template  String   @default("dica") // promocao | data_comemorativa | divulgacao | dica
  titulo    String
  texto     String   @default("")
  legenda   String
  hashtags  String   @default("")
  imagemUrl String?
  videoUrl  String? // URL do MP4 (Blob) quando formato="reels" — o piloto posta via media_type=REELS
  // Reels TEMÁTICO (vídeo do buffet, evergreen): de qual VideoTematico este post saiu. É o
  // vínculo REAL (não por texto do slug) que: (a) protege o MP4 do arquivamento de 24h — o
  // vídeo é reaproveitado em vários posts; (b) impede apagar do Blob um vídeo ainda agendado.
  // null = Reels de festa (ou post que não é Reels).
  videoTematicoId String?
  videoTematico   VideoTematico? @relation(fields: [videoTematicoId], references: [id], onDelete: SetNull)
  // ID do container de vídeo na Meta enquanto ele PROCESSA (guardado entre as passadas do piloto). "" = ainda não criado.
  reelsContainerId String @default("")
  extra     String? // JSON com dados específicos do template (oferta, validade, selo, linhas do título, cor de fundo...)
  tema      String?
  // Categoria de INTENÇÃO de marketing (ver Conteudo.categoria) — eixo da inteligência.
  // No feed, vem direto do template (determinístico); no carrossel, da IA.
  categoria String?
  status    String   @default("a_postar") // a_postar | postado
  aprovado  Boolean  @default(false) // revisão INTERNA do dono (não vai pra rede) — só marca "eu já revisei"
  postadoEm DateTime? // momento REAL em que foi publicado (null = ainda não postado)
  // formato: "feed" (4:5) | "story" (9:16) | "reels" (vídeo 9:16). Feed/Story renderizam arte;
  // Reels traz o vídeo pronto em videoUrl. O piloto escolhe o jeito de postar pelo formato.
  formato   String   @default("feed")
  // espelhar (só p/ formato feed): null = usa o padrão da marca; true/false = força.
  // Ligado: ao postar o feed, o piloto também sobe a versão Story automaticamente.
  espelhar  Boolean?
  // Engajamento no Instagram (coletado pelo piloto após postar). Story: alcance = views.
  mediaId     String? // ID da mídia no Instagram (chave pra buscar os insights)
  curtidas    Int? // ❤️ curtidas
  comentarios Int? // 💬 comentários
  alcance     Int? // 👁️ alcance (reach) — no Story, é a contagem de visualizações
  salvamentos Int? // 🔖 salvamentos (feed/carrossel)
  insightsEm  DateTime? // quando os números foram atualizados pela última vez
  createdAt DateTime @default(now())

  @@index([marcaId, data])
  @@index([videoTematicoId])
}

// Operadores do painel (admin mestre via ADMIN_SENHA; usuários extras opcionais).
model Usuario {
  id        String    @id @default(cuid())
  nome      String    @unique
  senhaHash String
  admin     Boolean   @default(false)
  plano     String? // pacote do cliente: essencial | profissional | turbo (null = não definido)
  acessoAte DateTime? // validade do acesso do cliente (null = sem restrição; admin ignora)
  valorMensal Int? // valor REAL que ESTE cliente paga por mês (R$) — null = usa o preço do pacote. Reflete o que de fato se cobra (ex: fundador 397, normal 599), independente do pacote.
  criadoEm  DateTime  @default(now())

  marcas    Marca[] // marcas que este usuário (cliente) administra
  chamados  Chamado[] // chamados de suporte que este usuário abriu
  pagamentos Pagamento[] // checkouts/pagamentos deste cliente (Mercado Pago)
}

// Registro de cada PAGAMENTO do checkout próprio (Mercado Pago). Ao ser aprovado, o webhook
// estende o `acessoAte` do usuário pelos `meses` do pedido. `refExterna` (id do pagamento no
// provedor) é única → garante IDEMPOTÊNCIA (webhook duplicado não estende o acesso 2x).
// Serve também de livro-caixa da receita real (≠ MRR estimado dos pacotes).
model Pagamento {
  id         String    @id @default(cuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plano      String // essencial | profissional | turbo
  periodo    String // mensal | anual
  meses      Int // meses de acesso liberados (1 ou 12)
  valor      Int // R$ cobrado (inteiro)
  provedor   String    @default("mercadopago")
  refExterna String    @unique // id do pagamento no provedor (idempotência)
  status     String    @default("aprovado") // aprovado | pendente | recusado
  criadoEm   DateTime  @default(now())
  aprovadoEm DateTime?

  @@index([usuarioId, criadoEm])
}

// Helpdesk: chamado de suporte que o CLIENTE abre e o ADMIN (Victor) responde dentro do
// painel. É o atendimento humano — quando a Bia (chat) não resolve, cai aqui. Cada chamado
// é uma conversa (várias ChamadoMensagem). Os flags naoLido* acendem o badge "novo" pra
// cada lado (cliente escreveu → novidade pro admin; admin respondeu → novidade pro cliente).
model Chamado {
  id             String   @id @default(cuid())
  usuarioId      String // quem abriu (cliente dono da marca)
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  marcaId        String? // marca relacionada (opcional, só referência — sem FK pra não travar)
  assunto        String
  status         String   @default("aberto") // aberto | resolvido
  naoLidoAdmin   Boolean  @default(true) // tem novidade pro admin ver (o cliente escreveu)
  naoLidoCliente Boolean  @default(false) // tem novidade pro cliente ver (o admin respondeu)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
  mensagens      ChamadoMensagem[]

  @@index([status, atualizadoEm])
  @@index([usuarioId, atualizadoEm])
}

model ChamadoMensagem {
  id        String   @id @default(cuid())
  chamadoId String
  chamado   Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  deAdmin   Boolean // true = resposta do suporte/admin; false = mensagem do cliente
  texto     String
  criadoEm  DateTime @default(now())

  @@index([chamadoId, criadoEm])
}

// Log de ações ("Postaí postou X pra marca Y") — feed de atividade do painel.
model AtividadeAgente {
  id       String   @id @default(cuid())
  agente   String
  texto    String
  marcaId  String?
  criadoEm DateTime @default(now())

  @@index([criadoEm])
}

// "Batimento" do piloto: o cron grava aqui toda vez que roda (singleton id="cron").
// O painel admin avisa se o último foi há muito tempo (cron pode ter travado).
model Heartbeat {
  id String   @id
  em DateTime
}

// Snapshot diário dos números da conta (seguidores/posts) — alimenta o gráfico de
// evolução "desde que usa o Postaí". 1 linha por marca por dia (upsert).
model MetricaMarca {
  id         String   @id @default(cuid())
  marcaId    String
  marca      Marca    @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  dia        DateTime // data do snapshot (00:00 BRT)
  seguidores Int
  posts      Int      @default(0)
  criadoEm   DateTime @default(now())

  @@unique([marcaId, dia])
  @@index([marcaId, dia])
}
