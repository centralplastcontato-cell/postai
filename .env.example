# ── Banco (Neon / Postgres) ──
POSTGRES_PRISMA_URL="postgresql://...?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://...  (conexão direta, sem pool)"

# ── Sessão do painel ──
ADMIN_SENHA="uma-senha-forte-de-admin"
SESSION_SECRET="uma-string-aleatoria-longa-pra-assinar-o-cookie"

# ── IA (geração de texto e imagem) ──
OPENAI_API_KEY="sk-..."

# ── Vercel Blob (guardar imagens geradas) ──
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Domínio público (a Meta busca as artes por URL aqui) ──
# Em produção, o domínio do deploy (ex: https://postai.vercel.app)
SITE_URL="http://localhost:3000"

# ── Cron (piloto automático) ──
CRON_SECRET="uma-string-aleatoria-pro-cron"
